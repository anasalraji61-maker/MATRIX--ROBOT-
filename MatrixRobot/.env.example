# === LLM ===
OPENROUTER_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=

# === Market Data ===
TWELVE_DATA_API_KEY=
POLYGON_API_KEY=

# === MT5 Bridge ===
MT5_BRIDGE_URL=
MT5_BRIDGE_SECRET=
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=

# === Database ===
DATABASE_URL=

# === App ===
SESSION_SECRET=
TRADING_STATE=PAPER_MODE
DISABLE_SCHEDULER=false
PORT=8080
NODE_ENV=development
PYTHON_AGENT_URL=http://localhost:8000

# ForexVPS (permanent host on same Windows box as MT5):
# NODE_ENV=production
# PYTHON_AGENT_URL=http://127.0.0.1:8000
# MT5_BRIDGE_URL=http://127.0.0.1:5555
# Optional override: DASHBOARD_DIST=C:\path\to\artifacts\dashboard\dist\public

# === Prop Firm ===
MAX_DAILY_DRAWDOWN_PCT=4.0
MAX_TOTAL_DRAWDOWN_PCT=9.0
MAX_RISK_PER_TRADE_PCT=0.8
MAX_CONCURRENT_POSITIONS=5
MAX_TRADES_PER_DAY=20
MIN_POSITION_HOLD_SECONDS=60

# === LLM Config ===
PRIMARY_MODEL=anthropic/claude-sonnet-4-5
OPENROUTER_INITIAL_BALANCE=

# === Execution Variance ===
EXEC_VARIANCE_ENABLED=false
EXEC_VARIANCE_LOT_JITTER_PCT=0.0
EXEC_VARIANCE_PIP_JITTER=0
EXEC_VARIANCE_ENTRY_DELAY_MIN_S=0
EXEC_VARIANCE_ENTRY_DELAY_MAX_S=0
EXEC_VARIANCE_SKIP_SIGNAL_PCT=0.0
EXEC_VARIANCE_SCHEDULE_JITTER_PCT=0.0
EXEC_VARIANCE_BREAKS_ENABLED=false

# === Account ===
ACCOUNT_PROFILE=FN_CHALLENGE
