# V12 ML Lab — مثال .env (لا تطبّق على V11 Production)
# انسخ إلى python-agents-v12-ml-lab\.env عند إنشاء المختبر (بعد 4–8 أسابيع)

TRADING_MODE_PROFILE=FULL_POWER_DEMO

# حساب MT5 ديمو ثانٍ — إلزامي
# MT5_LOGIN=
# MT5_PASSWORD=
# MT5_SERVER=

ML_FILTER_ENABLED=true
ML_FILTER_MODE=advisory
ML_MIN_WIN_PROB=0.45

ML_RETRAIN_ENABLED=true
ML_RETRAIN_INTERVAL_HOURS=168
ML_RETRAIN_SYMBOLS=EURUSD,XAUUSD,GBPUSD,USDJPY,XAGUSD
ML_RETRAIN_BARS=3000

RL_ENABLED=true
RL_MODE=shadow
RL_MIN_Q_VALUE=-0.10
RL_LEARNING_RATE=0.12

# ── بعد 4 أسابيع V12 ناجح — فعّل تدريجيًا (احذف #) ──
# ML_FILTER_MODE=enforce
# ML_MIN_WIN_PROB=0.35
# RL_MODE=enforce
